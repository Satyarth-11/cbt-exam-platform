# ===================================================================
# OMNITEST ENGINE — ENVIRONMENT & SECRETS CONFIGURATION (.env.example)
# ===================================================================
# Copy this file to .env before deploying:
# cp .env.example .env

# PostgreSQL Database Credentials
POSTGRES_DB=cbtdb
POSTGRES_USER=cbt_admin
POSTGRES_PASSWORD=cbt_password_secret_change_in_production

# JWT Authentication Key (256-bit+ cryptographically secure secret)
APP_JWT_SECRET=zK9xM2vR7pL5wQ8yU3tZ1aB4cD6eF8gH0jK2mN4pQ6rS8tU1vW3xY5zA7bC9dE1fG

# Mail Server Configuration
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025

# Container & Storage Configuration
SPRING_PROFILES_ACTIVE=dev
APP_SNAPSHOT_STORAGE_DIR=/app/snapshots
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
